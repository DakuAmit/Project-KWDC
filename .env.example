# KTM-WDC Vercel / Production Environment Template

APP_NAME="Kathmandu Warehousing & Distribution Center (KTM-WDC)"
APP_ENV=production
SECRET_KEY=your-secure-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Brevo Email
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-sender-email@domain.com
BREVO_SENDER_NAME=KTM-WDC

# Fiscal Parameters
VAT_RATE=0.13
MIN_ADMIN_MARGIN=0.10
MAX_ADMIN_MARGIN=0.15
SPACE_BLOCK_PERCENT=0.10
KWDC_IDLE_HOLDING_LIABILITY=0.0
